{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bpnm-doc-hub",
  "main": "src/server/worker.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "cc8e2a546317d0e17f696b246a8f69b9",
  "routes": [
    {
      "pattern": "bpnm.tungcv.vn",
      "custom_domain": true
    }
  ],
  // Plain-text vars are part of every deploy from this file. MAINTENANCE_MODE is "0" here; the
  // maintenance step of docs/ops/DEPLOY_RUNBOOK.md deploys the same commit with
  // `--var MAINTENANCE_MODE:1` (routes, bindings, assets and secrets unchanged).
  "vars": {
    "MAINTENANCE_MODE": "0",
    "ANDROID_TENANT": "bpnm"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bpnm-doc-hub-db",
      "database_id": "3b47381d-1449-403c-9c84-87f81213010c",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bpnm-doc-hub-files"
    }
  ],
  // Two production tenants share this code:
  //   top level            -> Worker bpnm-doc-hub      on bpnm.tungcv.vn            (`wrangler deploy`)
  //   env.document-manage  -> Worker quan-ly-cong-van  on document-manage.tungcv.vn (`wrangler deploy --env document-manage`)
  // routes, vars, d1_databases and r2_buckets are NOT inherited by an env, so each is repeated
  // here with that tenant's own resources. `name` is set explicitly so Wrangler does not append
  // the env suffix. Every D1 migration must be applied to BOTH databases (see DEPLOY_RUNBOOK).
  "env": {
    "document-manage": {
      "name": "quan-ly-cong-van",
      "routes": [
        {
          "pattern": "document-manage.tungcv.vn",
          "custom_domain": true
        }
      ],
      // Display name of this organisation (header and browser tab); BPNM uses the built-in name.
      "assets": {
        "directory": "dist/client-document-manage",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "vars": {
        "MAINTENANCE_MODE": "0",
        "ANDROID_TENANT": "document-manage",
        "APP_TITLE": "SGII Doc Hub",
        "APP_TAB_TITLE": "SGII"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "document-manager-db",
          "database_id": "dd6a5309-85ff-449b-bdbd-b1aa239dcb77",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "document-manager-files"
        }
      ]
    }
  }
}
